ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=100 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin arachne

COPY requirements.txt requirements-playwright.txt .

ARG PIP_INDEX_URL=
ARG PIP_TRUSTED_HOST=
RUN if [ -n "$PIP_INDEX_URL" ]; then \
      if [ -n "$PIP_TRUSTED_HOST" ]; then \
        pip install --no-cache-dir -i "$PIP_INDEX_URL" --trusted-host "$PIP_TRUSTED_HOST" -r requirements.txt -r requirements-playwright.txt; \
      else \
        pip install --no-cache-dir -i "$PIP_INDEX_URL" -r requirements.txt -r requirements-playwright.txt; \
      fi; \
    else \
      pip install --no-cache-dir -r requirements.txt -r requirements-playwright.txt; \
    fi

# Optional Debian apt mirror for `playwright install --with-deps`. Empty keeps official sources.
ARG APT_MIRROR=
RUN if [ -n "$APT_MIRROR" ]; then \
      (sed -i "s|deb.debian.org|${APT_MIRROR}|g; s|security.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources 2>/dev/null || true) \
      && (sed -i "s|deb.debian.org|${APT_MIRROR}|g; s|security.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list 2>/dev/null || true); \
    fi \
    && playwright install --with-deps chromium \
    && chmod -R 755 /ms-playwright

COPY app ./app

RUN mkdir -p /app/data && chown arachne:arachne /app/data

USER arachne
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
